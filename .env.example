# Copy to .env and adjust. The server reads these from the environment;
# docker-compose.yml passes the ones it uses through (COOKIE_SECURE,
# TRUSTED_PROXIES, PUBLIC_URL, ALLOW_SIGNUP, METRICS_TOKEN) and sets the rest
# itself (DATABASE_URL, DATA_DIR, MIGRATE).

# Listen address
ADDR=:8080

# Required. PostgreSQL, or DATABASE_URL=memory for a throwaway in-memory
# store (development only: nothing survives a restart).
DATABASE_URL=postgres://archivist:archivist@localhost:5432/archivist?sslmode=disable

# Apply pending migrations/ on boot (Postgres only). Migrations are goose SQL
# files tracked in goose_db_version. A database that has tables but no
# goose_db_version is refused: use an empty database.
MIGRATE=1

# Directory holding the migration files. Default "migrations" (relative to the
# working directory; the Docker image ships them at /app/migrations).
# MIGRATIONS_DIR=migrations

# Where staged uploads (uploads/) and filesystem blobs (blobs/: preserved
# archives + extracted media) live. Must survive restarts.
DATA_DIR=./data

# Largest accepted import upload in MB, all parts of a split export together.
# Social-media exports run to several GB. Default 8192.
# MAX_UPLOAD_MB=8192

# --- Abuse limits ---
# Password registration is closed by default (signup answers 403): create
# accounts with `archivist admin create-user`. 1 lets anyone who can reach
# the server sign up.
# ALLOW_SIGNUP=0

# --- OIDC login (optional, any number of providers) ---
# Comma-separated ids; each is configured as ARCHIVIST_OIDC_<ID>_* with the id
# upper-cased and "-" written as "_". Register
# https://<host>/api/auth/oidc/<id>/callback at the provider. The server builds
# that URL from PUBLIC_URL (required with OIDC unless every provider sets its
# own REDIRECT_URL; never taken from a request's Host header).
# PUBLIC_URL=https://archive.example.com
# ARCHIVIST_OIDC_PROVIDERS=gitea
# ARCHIVIST_OIDC_GITEA_ISSUER=https://gitea.example.com     # required; discovery at boot
# ARCHIVIST_OIDC_GITEA_CLIENT_ID=                           # required
# ARCHIVIST_OIDC_GITEA_CLIENT_SECRET=                       # unset = public client (PKCE only)
# ARCHIVIST_OIDC_GITEA_NAME=Gitea                           # login button label
# ARCHIVIST_OIDC_GITEA_SCOPES=openid email profile
# ARCHIVIST_OIDC_GITEA_REDIRECT_URL=                        # unset = PUBLIC_URL + /api/auth/oidc/gitea/callback
# ARCHIVIST_OIDC_GITEA_AUTO_SIGNUP=1                        # 0: existing accounts only
# ARCHIVIST_OIDC_GITEA_LINK_BY_EMAIL=1                      # attach a first login to the account with the same email, when provider AND account verified it

# Imports one user may have queued, running or still uploading at the same
# time. Default 3.
# MAX_ACTIVE_IMPORTS=3

# Storage one user's imports may occupy, in GiB: the uploaded archives plus
# the media extracted from them (each file once), and uploads still in flight.
# Deleting an import frees its share. Default 50.
# MAX_USER_ARCHIVE_GB=50

# Uploads are also refused (507) when the disk under DATA_DIR has less free
# space than the declared upload size plus a 1 GiB margin.

# Budget of one import run: the worker (one per server, shared by all users)
# stops an import that runs longer than IMPORT_TIMEOUT (0 = no limit) or whose
# archive yields more than MAX_IMPORT_EVENTS events. Events saved until then
# are kept; the owner sees why and can delete the import.
# IMPORT_TIMEOUT=12h
# MAX_IMPORT_EVENTS=25000000

# A janitor removes staged uploads that never became an import (the request or
# the server died mid-upload) once they are this old (Go duration, at least
# 1h: an upload still being received is "orphaned" too). Default 24h.
# STAGING_MAX_AGE=24h

# How long a login lasts (Go duration). Default 720h (30 days).
# SESSION_TTL=720h

# A session that is not used for this long ends, whatever is left of
# SESSION_TTL (Go duration, at least 15m). Default 336h (14 days); 0 disables
# the idle timeout. A value >= SESSION_TTL has no effect.
# SESSION_IDLE_TTL=336h

# Session cookies are marked Secure by default (assumes HTTPS).
# Set to 0 ONLY for plain-HTTP local development.
COOKIE_SECURE=0

# Number of reverse proxies in front of the server that append to
# X-Forwarded-For (1 for a single nginx/Caddy/Traefik). Rate limiting and logs
# then use the entry added by the outermost of them; entries further left are
# client-supplied and ignored. Default 0 = ignore the header, use the TCP peer.
# (The old alias TRUST_PROXY was removed; the server refuses to start with it.)
# TRUSTED_PROXIES=0

# Extra origins (comma-separated, scheme://host[:port]) the CSRF check accepts.
# Only needed when the proxy rewrites Host and old browsers must work.
# TRUSTED_ORIGINS=https://archive.example.com

# Bearer token /metrics requires (min. 16 chars). Unset = /metrics is open.
# METRICS_TOKEN=

# Structured logs: json (default) or text
LOG_FORMAT=json

# Dev only: seed a demo account (login "test" / "test" — deliberately trivial,
# it bypasses the password policy) with dummy data. In-memory store only: with
# DATABASE_URL set, 1 is ignored with a warning; "force" seeds PostgreSQL too.
# SEED_DEMO=1

# --- Blob storage (original archives + extracted media; write-once/immutable) ---
# Default: the local filesystem under $DATA_DIR/blobs (docker-compose.yml keeps
# it on the app's volume). For an S3-compatible object store — SILO via
# deploy/compose.s3.yml, or AWS S3 / Ceph RGW / Garage / any other — set
# BLOB_S3_ENDPOINT; the server checks endpoint and
# credentials at boot (failing fast if either is wrong), creates the bucket if
# it is missing, and reports the store in /readyz. Media served from it
# supports Range requests (seeking, Safari video) like the filesystem store.
# BLOB_S3_ENDPOINT=http://s3:9000
# BLOB_S3_BUCKET=archivist
# BLOB_S3_ACCESS_KEY=...
# BLOB_S3_SECRET_KEY=...
# BLOB_S3_REGION=us-east-1
# Server-side encryption at rest (SSE-S3, AES256, store-managed keys) on every
# upload. Off by default: MinIO/SILO reject the header unless a KMS is configured;
# AWS S3 encrypts by default anyway. Set to 1 once your store supports it.
# BLOB_S3_SSE=0
#
# The filesystem store serves a single node. To move an existing install to S3:
#   BLOB_S3_ENDPOINT=… BLOB_S3_ACCESS_KEY=… BLOB_S3_SECRET_KEY=… \
#     archivist-blobs migrate-to-s3 -from ./data/blobs      # or: make migrate-blobs
# It is idempotent and resumable; re-run until it reports "copied 0", then
# restart the server with the BLOB_S3_* variables set.

# deploy/compose.s3.yml (the optional S3 store) reads these two for the object
# store and the app alike; it refuses to start without them. Password: at
# least 8 characters. Enable the overlay for plain `docker compose` with
#   COMPOSE_FILE=docker-compose.yml:deploy/compose.s3.yml
# and for deploy/deploy.sh with
#   ARCHIVIST_COMPOSE_OVERLAYS=deploy/compose.s3.yml
# MINIO_ROOT_USER=archivist
# MINIO_ROOT_PASSWORD=
